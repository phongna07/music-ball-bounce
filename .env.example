# Copy to .env (gitignored) to configure rendering for this machine.
# Precedence: CLI flags > shell env > .env > render.config.json > default ("gpu")

# Render mode: "gpu" (default Remotion CLI) or "cpu" (multi-browser SwiftShader)
# MBB_RENDERER=cpu

# Optional OpenGL backend override (defaults to "angle" for gpu, "swangle" for cpu)
# MBB_GL=angle

# GPU mode options:
# MBB_CONCURRENCY=4

# CPU mode options (auto-sized to free CPU and RAM if unset):
# MBB_WORKERS=12
# MBB_TABS=1
# MBB_CORES_PER_WORKER=4
# MBB_BROWSER_MEM_MB=800
# MBB_TAB_MEM_MB=500
# MBB_RESERVE_MEM_MB=4096

# Optional machine name override when matching render.config.json:
# MBB_MACHINE=my-cpu-server
